# ============ BarberOS · Variables de entorno ============
# Copia este archivo a `.env` en la raíz del repo (el backend lo lee al arrancar).

# --- Backend (Express) ---
# Cadena de conexión a PostgreSQL. En Supabase: Project Settings > Database > URI
DATABASE_URL="postgresql://postgres:PASSWORD@db.HOST.supabase.co:5432/postgres"

# Secreto para firmar los JWT (OBLIGATORIO en producción. Cambia a un valor largo y aleatorio:
# genera uno con `openssl rand -hex 64`). Nunca lo compartas.
JWT_SECRET="cambia-esta-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="30d"

# Puerto del API (dev usa 4000; Render lo inyecta automáticamente en producción).
PORT="4000"

# --- Seguridad ---
# CORS: lista blanca de orígenes permitidos (separados por coma).
# En producción lo ideal es el dominio del frontend, ej. https://barberos.onrender.com
# Sin valor ⇒ solo mismo origen (la app sirve el frontend) + localhost de desarrollo.
CORS_ORIGIN="https://mi-barberia.com"

# Confiar en el header X-Forwarded-For del primer proxy/reverse (Render/LB).
# En producción debería ser true para que el rate limiting use la IP real del cliente.
TRUST_PROXY="true"

# SSL de la base de datos:
#   - Activado automáticamente en producción o si DATABASE_URL trae sslmode.
#   - Verificación estricta del certificado por defecto; el pooler de Supabase
#     (host ...pooler.supabase.com) usa su propio CA, así que ahí se omite
#     automáticamente la verificación de cadena.
#   - Para forzar: PG_REJECT_UNAUTHORIZED="1" (estricto) o "0" (sin verificar cadena).
#   - Solo si tu proveedor de BD lo requiere, PGSSL="0" desactiva SSL (no recomendado).
PGSSL="1"
PG_REJECT_UNAUTHORIZED="1"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"